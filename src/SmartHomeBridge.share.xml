                  <Enumeration Value="0" Id="%ENID%" Text="Nein"                             />
                  <Enumeration Value="1" Id="%ENID%" Text="Ja"  />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-BRIDoorWindowUpDownHandling" Name="BRIDoorWindowUpDownHandling">
                <TypeRestriction Base="Value" SizeInBit="4">
                  <Enumeration Value="0" Id="%ENID%" Text="Nicht verwenden"                        />
                  <Enumeration Value="3" Id="%ENID%" Text="Öffnen und Schließen" />
                  <Enumeration Value="2" Id="%ENID%" Text="Nur öffnen senden"               />
                  <Enumeration Value="1" Id="%ENID%" Text="Nur schließen senden"              />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-BRIDoorWindowOpenDirection" Name="BRIDoorWindowOpenDirection">
                <TypeRestriction Base="Value" SizeInBit="4">
                  <Enumeration Value="0" Id="%ENID%" Text="Nach links"                       />
                  <Enumeration Value="1" Id="%ENID%" Text="Nach rechts"                      />
                  <Enumeration Value="2" Id="%ENID%" Text="Mittig auseinander links/rechts"  />
                  <Enumeration Value="3" Id="%ENID%" Text="Nach oben"                        />
                  <Enumeration Value="4" Id="%ENID%" Text="Nach unten"                       />
                  <Enumeration Value="5" Id="%ENID%" Text="Mittig auseinander oben/unten"    />
                </TypeRestriction>
              </ParameterType>
             


              <ParameterType Id="%AID%_PT-BRIIconName" Name="BRIIconName">
                  <TypeText  SizeInBit="64"  Pattern="^[A-Za-z0-9_-]*$" />
              </ParameterType>

            </ParameterTypes>
            <Parameters>
              <!-- Basic Settings -->
              <Union SizeInBit="296">
                <Memory CodeSegment="%AID%_RS-04-00000" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%T%000002" Offset="0" BitOffset="0" Name="HomeKitEnabled" ParameterType="%AID%_PT-OnOffYesNo" Text="Apple HomeKit" Value="1" />
                <Parameter Id="%AID%_UP-%T%000003" Offset="0" BitOffset="1" Name="HueEnabled" ParameterType="%AID%_PT-OnOffYesNo" Text="Hue Emulation (Nur für Alexa)" Value="1" />
                <Parameter Id="%AID%_UP-%T%000000" Offset="1" BitOffset="0" Name="VisibleChannels" ParameterType="%AID%_PT-BRINumChannels" Text="Verfügbare Geräte" Value="%BRI_NumChannelsDefault%" SuffixText=" von %N%" /> 
                <Parameter Id="%AID%_UP-%T%000001" Offset="2" BitOffset="0"  Name="BridgeName" ParameterType="%AID%_PT-BRIDeviceName" Text="Name" Value="OpenKNX Smart Home Bridge" />
                <!-- ^^^ 25 characters + \0 terminator = 26 bytes ^^^ -->
                <Parameter Id="%AID%_UP-%T%000005" Offset="28" BitOffset="0" Name="PairingCode" ParameterType="%AID%_PT-BRIPairingCode" Text="Kopplungscode" Value="46637726" />
                <!-- ^^^ 8 characters + \0 terminator = 9 bytes ^^^ -->
              </Union>
          		<!-- Add not allowed -->
							<Parameter Id="%AID%_P-%T%000006" Name="AddNotAllowed" ParameterType="%AID%_PT-OnOffYesNo" Text="AddNotAllowed" Value="0"  Access="None"/> 
              <!-- HomeKit Supported -->
							<Parameter Id="%AID%_P-%T%000007" Name="HomeKitSupport" ParameterType="%AID%_PT-OnOffYesNo" Text="HomeKitSupported" Value="%BRI_HomeKitSupport%"  Access="None"/> 
			        <!-- Hue Supported -->
							<Parameter Id="%AID%_P-%T%000008" Name="HueSupport" ParameterType="%AID%_PT-OnOffYesNo" Text="HueSupported" Value="%BRI_HueSupport%"  Access="None"/> 
			        <!-- Base Settings -->
							<Parameter Id="%AID%_P-%T%000009" Name="BrigdeSettings" ParameterType="%AID%_PT-OnOffYesNo" Text="BrigdeSettings" Value="%BRI_BridgeSettings%"  Access="None"/> 
			       <!-- Base Settings -->
							<Parameter Id="%AID%_P-%T%000010" Name="DisplaySettings" ParameterType="%AID%_PT-OnOffYesNo" Text="DisplaySettings" Value="%BRI_DisplaySettings%"  Access="None"/> 
				
              <!-- Next Id="%TT%00011" -->  		
            </Parameters>
            <ParameterRefs>
              <!-- ParameterRef have to be defined for each parameter, pay attention, that the ID-part (number) after R- is unique! -->
              <!-- ParameterRef are used in the ETS UI -->
              <ParameterRef Id="%AID%_UP-%T%000000_R-%T%00000001" RefId="%AID%_UP-%T%000000" /> <!-- Visible channels -->
              <ParameterRef Id="%AID%_UP-%T%000001_R-%T%00000101" RefId="%AID%_UP-%T%000001" /> <!-- Bridge Name -->
              <ParameterRef Id="%AID%_UP-%T%000002_R-%T%00000201" RefId="%AID%_UP-%T%000002" /> <!-- Homekit -->
              <ParameterRef Id="%AID%_UP-%T%000003_R-%T%00000301" RefId="%AID%_UP-%T%000003" /> <!-- Hue Emulation -->
              <ParameterRef Id="%AID%_UP-%T%000005_R-%T%00000501" RefId="%AID%_UP-%T%000005" /> <!-- Homekit Pairing Code -->
              <ParameterRef Id="%AID%_P-%T%000006_R-%T%00000601" RefId="%AID%_P-%T%000006" /> <!-- AddNotAllowed -->
              <ParameterRef Id="%AID%_P-%T%000007_R-%T%00000701" RefId="%AID%_P-%T%000007" /> <!-- HomeKit Supported -->
              <ParameterRef Id="%AID%_P-%T%000008_R-%T%00000801" RefId="%AID%_P-%T%000008" /> <!-- Hue Supported -->
              <ParameterRef Id="%AID%_P-%T%000009_R-%T%00000901" RefId="%AID%_P-%T%000009" /> <!-- Brigde Settings -->
              <ParameterRef Id="%AID%_P-%T%000010_R-%T%00001001" RefId="%AID%_P-%T%000010" /> <!-- Display Settings -->
            </ParameterRefs>
            <ComObjectTable>
            </ComObjectTable>        
            <ComObjectRefs>
            </ComObjectRefs>
            <Script>
							<op:include href="SmartHomeBridge.script.js" prefix="BRI" type="script" />
						</Script>

            <Extension>
              <Baggage RefId="%FILE-HELP-de%" />
              <Baggage RefId="%FILE-ICONS%" />
            </Extension>

          </Static>

     
          <!-- Here starts the UI definition -->
          <Dynamic>
            <Channel Id="%AID%_CH-%T%" Name="Main" Number="%T%" Text="%BRI_TabName%" Icon="%BRI_TabIcon%">
             
              <ParameterBlock Id="%AID%_PB-nnn" Name="General" Text="Allgemein" Icon="cog-outline" HelpContext="BRI-Smarthome-Bridge">
                <!-- <ParameterSeparator Id="%AID%_PS-4" Text="" UIHint="HorizontalRuler" /> -->
                <ParameterSeparator Id="%AID%_PS-nnn" Text="%BRI_TabName%" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />

                <ParameterRefRef IndentLevel="1" RefId="%AID%_P-%T%000007_R-%T%00000701" /> <!-- HomeKit Supported -->
                <ParameterRefRef IndentLevel="1" RefId="%AID%_P-%T%000008_R-%T%00000801" /> <!-- Hue Supported -->
                <ParameterRefRef IndentLevel="1" RefId="%AID%_P-%T%000009_R-%T%00000901" /> <!-- Brigde Settings -->
                <ParameterRefRef IndentLevel="1" RefId="%AID%_P-%T%000010_R-%T%00001001" /> <!-- Display Settings -->

                <!-- Bridge Settings -->
                <choose ParamRefId="%AID%_P-%T%000009_R-%T%00000901" > 
                  <when test="1"> 
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Basiseinstellungen" UIHint="Headline" />
                    <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%T%000001_R-%T%00000101" HelpContext="%DOC%" /> <!-- Bridge Name -->
                  </when> 
                </choose>

            
                <!-- HomeKit Supported -->
                <choose ParamRefId="%AID%_P-%T%000007_R-%T%00000701" >  <!-- HomeKit -->
                  <when test="1"> 
                    <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%T%000002_R-%T%00000201" HelpContext="%DOC%" /> <!-- Homekit -->
                  </when>
                  <when test="0"> 
                     <Assign TargetParamRefRef="%AID%_UP-%T%000002_R-%T%00000201" Value="0" /> <!-- Homekit -->
                  </when>
                </choose>
                <!-- Hue Supported -->
                <choose ParamRefId="%AID%_P-%T%000008_R-%T%00000801" >  <!-- Hue -->
                  <when test="1"> 
                    <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%T%000003_R-%T%00000301" HelpContext="%DOC%" /> <!-- Hue -->
                  </when>
                  <when test="0"> 
                    <Assign TargetParamRefRef="%AID%_UP-%T%000003_R-%T%00000301" Value="0" /> <!-- Hue -->
                  </when>
                </choose>
            
                <!-- <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="WIFI" UIHint="Headline" /> -->
                <!--<ParameterRefRef IndentLevel="1" RefId="%AID%_P-%T%000003_R-%T%00000301" />--> <!-- SSID -->
                <!--<<ParameterRefRef IndentLevel="1" RefId="%AID%_P-%T%000004_R-%T%00000401" />--> <!-- Password -->
            
                <choose ParamRefId="%AID%_UP-%T%000002_R-%T%00000201" >  <!-- HomeKit -->
                  <when test="1"> <!-- Homekit OR Homekit & Hue -->
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Homekit" UIHint="Headline" />
                    <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%T%000005_R-%T%00000501" HelpContext="%DOC%" /> <!-- Pairing Code -->
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Hinweis: Apple lässt beim Koppeln einfache Codes (z.B. nur Einser) nicht zu. Das kann durch ETS nicht geprüft werden. Es wird daher empfohlen den Standard-Wert 46637726 zu verwenden." UIHint="Information" />
                  </when>
                </choose> 

                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
            
                <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%T%000000_R-%T%00000001" HelpContext="%DOC%" /> <!-- Visible channels -->
                
                <op:usePart name="ChannelLimitWarning" xpath="//ParameterBlock/*" />
                
                <op:include href="SmartHomeBridge.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Settings']/*" type="template" prefix="BRI" IsInner="true" />

                  
              </ParameterBlock>
        
              <!-- Bridge channel settings -->
              <op:include href="SmartHomeBridge.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Channel']/*"  type="template" prefix="BRI" IsInner="true" />
                    

              <!-- More Page -->
							<choose ParamRefId="%AID%_UP-%T%000000_R-%T%00000001">
								<when test="&lt;%N%">
									<ParameterBlock Id="%AID%_PB-nnn" Name="BRIAdditionalChannels" Text="(mehr)" Icon="dots-horizontal" HelpContext="BRI-MorePage">									
										<ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
				
										<op:include href="SmartHomeBridge.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='More']/*" type="template" prefix="BRI" IsInner="true" />
										
										 <!-- Hidden -->
										 <!-- Add not allowed -->
										<ParameterRefRef IndentLevel="1" RefId="%AID%_P-%T%000006_R-%T%00000601" />
										<choose ParamRefId="%AID%_P-%T%000006_R-%T%00000601" >
											<when test="1">
												<ParameterSeparator Id="%AID%_PS-nnn" Text="Hinzufügen von 'Deaktiviert' nicht möglich. Es muss zuerst eine Auswahl getroffen werden." UIHint="Error" />
											</when>
										</choose>
										
										<Button Id="%AID%_B-%TT%00200" Text="Hinzufügen" EventHandler="briAddChannel" />

                    <op:usePart name="ChannelLimitWarning" xpath="//ParameterBlock/*" />
              
										<!-- HelpContext="BASE-Verfuegbare-Kanaele" IndentLevel="1" /-->
									</ParameterBlock>
								</when>
							</choose>
              
            </Channel>
          </Dynamic>
